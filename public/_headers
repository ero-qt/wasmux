# Netlify/Cloudflare Pages header rules.
# vite copies public/ verbatim into the build output, so this file lands at
# the build root and is picked up automatically by both platforms.
#
# the headers below must come from the HTTP layer; they cannot be expressed
# via <meta http-equiv> and so are not in index.html.

/*
  # Cross-Origin Isolation (required for SharedArrayBuffer, WASM threads, memory64).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

  # frame-ancestors is ignored when set via <meta>; it must be an HTTP header.
  Content-Security-Policy: frame-ancestors 'none'

  # deny every powerful feature by default. multiple Permissions-Policy headers
  # are merged by the user agent into a single comma-joined list.
  Permissions-Policy: accelerometer=()
  Permissions-Policy: ambient-light-sensor=()
  Permissions-Policy: autoplay=(self)
  Permissions-Policy: battery=()
  Permissions-Policy: bluetooth=()
  Permissions-Policy: camera=()
  Permissions-Policy: clipboard-read=(self)
  Permissions-Policy: clipboard-write=(self)
  Permissions-Policy: display-capture=()
  Permissions-Policy: encrypted-media=()
  Permissions-Policy: fullscreen=(self)
  Permissions-Policy: gamepad=()
  Permissions-Policy: geolocation=()
  Permissions-Policy: gyroscope=()
  Permissions-Policy: hid=()
  Permissions-Policy: idle-detection=()
  Permissions-Policy: magnetometer=()
  Permissions-Policy: microphone=()
  Permissions-Policy: midi=()
  Permissions-Policy: payment=()
  Permissions-Policy: picture-in-picture=()
  Permissions-Policy: publickey-credentials-get=()
  Permissions-Policy: screen-wake-lock=(self)
  Permissions-Policy: serial=()
  Permissions-Policy: usb=()
  Permissions-Policy: web-share=()
  Permissions-Policy: xr-spatial-tracking=()

  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
