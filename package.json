{
  "name": "wasmux",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "an in-browser, privacy-first, wasm-powered video editor",
  "license": "MIT",
  "packageManager": "bun@1.1.42",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "vite build",
    "serve:dev": "vite",
    "serve:preview": "vite preview",
    "check": "bun run check:types && bun run check:lint && bun run check:test",
    "check:types": "tsc --noEmit",
    "check:lint": "biome check .",
    "check:test": "vitest run",
    "check:test:coverage": "vitest run --coverage",
    "fix": "bun run fix:lint",
    "fix:lint": "biome check --write --unsafe ."
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/i18n": "^2.2.1",
    "immer": "^11.1.4",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "^1.1.14",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.4"
  }
}
